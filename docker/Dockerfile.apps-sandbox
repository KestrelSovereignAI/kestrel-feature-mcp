# Public MCP Apps sandbox, independent of the authenticated agent host.
# Follow the maintained Node LTS used by the browser/service CI lane.
FROM node:lts-bookworm-slim
LABEL org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /app
COPY --chmod=0444 kestrel_feature_mcp/apps_sandbox/sandbox-entry.js \
    kestrel_feature_mcp/apps_sandbox/sandbox-service.mjs \
    kestrel_feature_mcp/apps_sandbox/parent-entry.js \
    kestrel_feature_mcp/apps_sandbox/THIRD_PARTY_NOTICES.txt \
    kestrel_feature_mcp/apps_sandbox/manifest.json ./
COPY --chmod=0444 LICENSE /usr/share/licenses/kestrel-mcp-apps/LICENSE

USER node
ENTRYPOINT ["node", "/app/sandbox-service.mjs"]
# Mount the explicit configuration read-only; it contains no host credentials.
CMD ["--config", "/etc/kestrel-mcp-apps/sandbox.json"]
